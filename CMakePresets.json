{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 1,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64"
      },
      "binaryDir": "F:/AiluEngine/build/${presetName}",
      "cacheVariables": {
        "AiluBuildPath": "F:/AiluEngine/artifacts",
        "AILU_ENABLE_LUA_SCRIPTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "develop",
      "displayName": "Ailu Develop",
      "inherits": "windows-base",
      "cacheVariables": {
        "AILU_ENABLE_ASSERTS": "ON",
        "AILU_ENABLE_D3D_DEBUG_LAYER": "OFF",
        "AILU_ENABLE_PIX_MARKERS": "OFF",
        "AILU_ENABLE_ENGINE_PROFILER": "OFF",
        "AILU_ENABLE_TRACY": "ON",
        "AILU_TRACY_ON_DEMAND": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Ailu Debug",
      "inherits": "windows-base"
    },
    {
      "name": "player-debug",
      "displayName": "Ailu Player Debug",
      "inherits": "debug",
      "cacheVariables": {
        "AILU_BUILD_PLAYER": "ON"
      }
    },
    {
      "name": "player-release",
      "displayName": "Ailu Player Release",
      "inherits": "release",
      "cacheVariables": {
        "AILU_BUILD_PLAYER": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Ailu Release",
      "inherits": "windows-base"
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "build-debug-smoke",
      "displayName": "Ailu Debug Smoke Targets",
      "configurePreset": "debug",
      "configuration": "Debug",
      "targets": ["ailu_test_targets"]
    },
    {
      "name": "build-player-debug",
      "displayName": "Ailu Player Debug Package",
      "configurePreset": "player-debug",
      "configuration": "Debug",
      "targets": ["package_player"]
    },
    {
      "name": "build-player-release",
      "displayName": "Ailu Player Release Package",
      "configurePreset": "player-release",
      "configuration": "Release",
      "targets": ["package_player"]
    },
    {
      "name": "build-release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "build-develop",
      "configurePreset": "develop",
      "configuration": "RelWithDebInfo"
    }
  ],
  "workflowPresets": [
    {
      "name": "package-player-debug",
      "displayName": "Ailu Package Player Debug",
      "steps": [
        {
          "type": "configure",
          "name": "player-debug"
        },
        {
          "type": "build",
          "name": "build-player-debug"
        }
      ]
    },
    {
      "name": "package-player-release",
      "displayName": "Ailu Package Player Release",
      "steps": [
        {
          "type": "configure",
          "name": "player-release"
        },
        {
          "type": "build",
          "name": "build-player-release"
        }
      ]
    }
  ]
}
